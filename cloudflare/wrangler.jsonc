{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "simonsealsapi",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "simonsealsapi.dev",
      "custom_domain": true
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://simonsealsapi.dev"
  },
  "assets": {
    "directory": "../static",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "simonsealsapi-db",
      "database_id": "38d40854-a0a5-4469-a38a-b152e2b732a8",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": false
  }
}
